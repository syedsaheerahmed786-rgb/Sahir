<resources>
    <style name="Theme.Meraki" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/meraki_red</item>
        <item name="colorPrimaryDark">@color/meraki_red_dark</item>
        <item name="colorAccent">@color/meraki_gold</item>
        <item name="android:statusBarColor">@color/meraki_red</item>
        <item name="android:windowBackground">@android:color/white</item>
    </style>

    <style name="Theme.Meraki.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/meraki_red</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Meraki</item>
    </style>
</resources>
